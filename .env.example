# BOM Optimizer — Environment Configuration
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./bom_platform.db
ENVIRONMENT=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Auth (Phase 0 mock JWT — replace with Entra ID in a later phase) ──────
JWT_SECRET_KEY=local-demo-secret-please-replace-in-real-production-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ── OpenAI SDK (per lead's direction) ──────────────────────────────────────
# Used by POST /api/explain to generate natural-language explanations of
# BOM recommendations. Leave blank to use the deterministic rule-based
# explainer (Phase 0 default — no external calls, no cost).
#
# 1. Generate a key at https://platform.openai.com/api-keys
# 2. Paste it below (starts with "sk-")
# 3. Restart the API — no code changes needed
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Azure OpenAI (optional alternative — only used if OPENAI_API_KEY is blank) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
